def shift_rows(text, act):
    #text = sub_bytes(text)
    result_text = []

    help_box = [0, 4, 8, 12,
                5, 9, 13, 1,
                10, 14, 2, 6,
                15, 3, 7, 11]
    help_box2 = [0, 7, 10, 13,
                 1, 4, 11, 14,
                 2, 5, 8, 15,
                 3, 6, 9, 12]
    if act == 0:
        for i in range(len(text) // 16):
            for j in range(16):
                result_text.append(text[help_box[i*16+j]])
    elif act == 1:
        for i in range(len(text) // 16):
            for j in range(16):
                result_text.append(text[help_box2[i*16+j]])

    return result_text


def multy_galua(num1, num2):
    result_num = []

    for i in range(-1, -9, -1):
        if num1 > 0b11111111:
            num1 = num1 % 0b100000000
            num1 = num1 ^ 0b00011011
        if str(format(num2, '08b'))[i] == '1':
            result_num.append(num1)
        num1 = num1 << 1
    answer = result_num[0]
    for i in range(1, len(result_num)):
        answer = answer ^ result_num[i]

    return format(answer, '08b')


def mix_column(text, act):
    #text = shift_rows(text)
    help_box = [2, 3, 1, 1,
                1, 2, 3, 1,
                1, 1, 2, 3,
                3, 1, 1, 2]
    help_box2 = [0x0e, 0x0b, 0x0d, 0x09,
                0x09, 0x0e, 0x0b, 0x0d,
                0x0d, 0x09, 0x0e, 0x0b,
                0x0b, 0x0d, 0x09, 0x0e]
    result_text = []
    spec_text = []
    half_result = [0b00000000, 0b00000000, 0b00000000, 0b00000000]

    if act == 0:
        for i in range(len(text) // 4):
            for j in range(4):  # Каждая буква постолбцово (j*4+i)
                for l in range(4):  # Каждые четыре значения Галуа построчно (j*4+l)
                    if help_box[j * 4 + l] == 2:
                        half_result[l] = int(text[l * 4 + i], 16)
                        half_result[l] = half_result[l] << 1
                        if len(format(half_result[l], '08b')) > 8:
                            half_result[l] = half_result[l] % 0b100000000
                            half_result[l] = half_result[l] ^ 0b00011011
                    elif help_box[j * 4 + l] == 3:
                        half_result[l] = int(text[l * 4 + i], 16)
                        half_result[l] = half_result[l] << 1
                        half_result[l] = half_result[l] ^ int(text[l * 4 + i], 16)
                        if len(format(half_result[l], '08b')) > 8:
                            half_result[l] = half_result[l] % 0b100000000
                            half_result[l] = half_result[l] ^ 0b00011011
                    elif help_box[j * 4 + l] == 1:
                        half_result[l] = int(text[l * 4 + i], 16)

                result_text.append(format(half_result[0] ^ half_result[1] ^ half_result[2] ^ half_result[3], '02x'))
    elif act == 1:
        for i in range(len(text) // 4):
            for j in range(4):  # Каждая буква постолбцово (j*4+i), построчно (i*4+l)
                for l in range(4):  # Каждые четыре значения Галуа построчно (j*4+l)
                    half_result[l] = int(multy_galua(int(text[i*4+l], 16), help_box2[j*4+l]), 2)

                spec_text.append(format(half_result[0] ^ half_result[1] ^ half_result[2] ^ half_result[3], '02x'))
        result_text = [''] * len(spec_text)
        for i in range(len(spec_text) // 4):
            for j in range(4):
                result_text[j*4+i] = spec_text[i*4+j]

    return result_text


def key_xor(text, key):
    result_text = []
    for i in range(len(text)):
        result_text.append(format(int(text[i], 16) ^ int(key[i], 16), '02x'))

    return result_text


def key_expansion(key):
    result_keys = list(key)
    rcon = [0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36]
    help_box = [1, 2, 3, 0]

    for i in range(2, 15): #Блоки
        help_keys = []
        if i % 2 == 0:
            for s in range(4):
                help_keys.append(str(result_keys[(i*16)-4+help_box[s]]))
            help_keys = sub_bytes(help_keys, 0)
            for s in range(4):
                if s == 0:
                    result_keys.append(format(int(help_keys[s], 16) ^ int(result_keys[(i-2)*16+s], 16) ^ rcon[i // 2], '02x'))
                else:
                    result_keys.append(format(int(help_keys[s], 16) ^ int(result_keys[(i - 2) * 16 + s], 16) ^ 0x00, '02x'))
        else:
            for s in range(4):
                help_keys.append(str(result_keys[(i*16)-4+s]))
            help_keys = sub_bytes(help_keys, 0)
            for s in range(4):
                result_keys.append(format(int(help_keys[s], 16) ^ int(result_keys[(i-2)*16+s], 16), '02x'))

        for s in range(3):
            for k in range(4):
                result_keys.append(format(int(result_keys[(i*16)+s*4+k], 16) ^ int(result_keys[(i-2)*16+(s+1)*4+k], 16), '02x'))

    return result_keys


def to_aes(text, key):
    result_text = ""
    text = text_to_byte(text)
    set_key = key_expansion(text_to_byte(key))

    text = key_xor(text, set_key[0:16])
    for i in range(1, 14):
        key = set_key[0+i*16:16+i*16]
        text = key_xor(mix_column(shift_rows(sub_bytes(text, 0), 0), 0), key)
    text = key_xor(shift_rows(sub_bytes(text, 0), 0), set_key[224:240])

    for i in range(len(text)):
        result_text += text[i]

    return result_text


def from_aes(message, key):
    text = []
    set_key = key_expansion(text_to_byte(key))

    for i in range(len(message) // 2):
        help_text = ""
        for j in range(2):
            help_text += message[i * 2 + j]
        text.append(help_text)

    text = key_xor(text, set_key[224:240])
    for i in range(13):
        key = set_key[208-i*16:224-i*16]
        text = mix_column(key_xor(sub_bytes(shift_rows(text, 1), 1), key), 1)
        #text = sub_bytes(shift_rows(mix_column(key_xor(text, key), 1), 1), 1)
    text = key_xor(sub_bytes(shift_rows(text, 1), 1), set_key[0:16])

    result_text = text_from_byte(text)

    return result_text

