def text_to_byte(text):
    result_text = []
    for i in range(len(text)):
        help_letter = text[i]
        result_text.append(format(ord(help_letter), '02x'))
    return result_text


def text_from_byte(text):
    result_text = ""
    for i in range(len(text)):
        result_text += chr(int(text[i], 16))

    return result_text


