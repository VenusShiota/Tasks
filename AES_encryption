            result_text.append(text[invhelp_box[i]])

    return result_text

def multy_galua(num1, num2):
    xor_box = []
    num1 = int(num1, 16)

    for i in range(-1, -5, -1):
        if num1 > 0b11111111:
            num1 %= 0b100000000
            num1 ^= 0b00011011
        if str(format(num2, '08b'))[i] == '1':
            xor_box.append(num1)
        num1 = num1 << 1

    result_num = xor_box[0]
    for i in range(1, len(xor_box)):
        result_num ^= xor_box[i]

    return format(result_num, '02x')

def mix_column(text, act):
    result_text = []
    help_box = [2, 3, 1, 1,
                1, 2, 3, 1,
                1, 1, 2, 3,
                3, 1, 1, 2]
    xor_box = [0b00000000, 0b00000000, 0b00000000, 0b00000000]
    invhelp_box = [0x0e, 0x0b, 0x0d, 0x09,
                   0x09, 0x0e, 0x0b, 0x0d,
                   0x0d, 0x09, 0x0e, 0x0b,
                   0x0b, 0x0d, 0x09, 0x0e]

    for i in range(4):
        for j in range(4):
            for l in range(4):
                if act == 0:
                    if help_box[j*4+l] == 1:
                        xor_box[l] = int(text[i*4+l], 16)
                    elif help_box[j*4+l] == 2:
                        help_text = int(text[i*4+l], 16) << 1
                        if help_text > 0b11111111:
                            help_text %= 0b100000000
                            help_text ^= 0b00011011
                        xor_box[l] = help_text
                    elif help_box[j*4+l] == 3:
                        help_text = int(text[i*4+l], 16) << 1
                        help_text ^= int(text[i*4+l], 16)
                        if help_text > 0b11111111:
                            help_text %= 0b100000000
                            help_text ^= 0b00011011
                        xor_box[l] = help_text
                elif act == 1:
                    xor_box[l] = int(multy_galua(text[i*4+l], invhelp_box[j*4+l]), 16)

            result_text.append(format(xor_box[0] ^ xor_box[1] ^ xor_box[2] ^ xor_box[3], '02x'))

    return result_text

def key_gen(key):
    result_keys = key
    help_box = [-3, -2, -1, -4]
    rcon = [0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20] 
    
    for i in range(13):
        for j in range(4):
            help_keys = [] 
            if i % 2 == 0 and j == 0:
                for l in range(4):
                    help_keys.append(result_keys[help_box[l]])
                help_keys = sub_bytes(help_keys, 0)
                for l in range(4):
                    if l == 0:
                        result_keys.append(format(int(help_keys[l], 16) ^ rcon[i//2] ^ int(result_keys[i*16+i], 16), '02x'))
                    else:
                        result_keys.append(format(int(help_keys[l], 16) ^ 0x00 ^ int(result_keys[i*16+i], 16), '02x'))
            elif i % 2 == 1 and j == 0:
                for l in range(-1, -5, -1):
                    help_keys.append(result_keys[l])
                help_keys = sub_bytes(help_keys, 0)
                for l in range(4):
                    result_keys.append(format(int(help_keys[l], 16) ^ int(result_keys[i*16+i], 16), '02x'))
            else:
                for l in range(-1, -5, -1):
                    help_keys.append(result_keys[l])
                for l in range(4):
                    result_keys.append(format(int(help_keys[l], 16) ^ int(result_keys[i*16+i], 16), '02x'))
                    
    return result_keys 


def key_xor(text, key):
    result_text = []

    for i in range(16):
        result_text.append(format(int(text[i], 16) ^ int(key[i], 16), '02x'))

    return result_text

