                5, 6, 7, 4,
                10, 11, 8, 9,
                15, 12, 13, 14]
    invhelp_box = [0, 1, 2, 3,
                  7, 4, 5, 6,
                  10, 11, 8, 9,
                  13, 14, 15, 12]

    if act == 0:
        for i in range(16):
            result_text.append(text[help_box[i]])
